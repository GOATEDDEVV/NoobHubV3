-- Feature Logic Connections
autoKillBtn.MouseButton1Click:Connect(function()
    autoKillEnabled = not autoKillEnabled
    setButtonActive(autoKillBtn, autoKillGrad, autoKillStroke, autoKillEnabled, "⚔️ Auto Kill: ON", "⚔️ Auto Kill: OFF")

    if autoKillEnabled then
        connectionLoop = RunService.Heartbeat:Connect(function()
            local bossModel, bossRoot = findBossRoot()
            if bossModel and bossRoot then
                applyImmuneHeadAnchor(bossModel, bossRoot)
                equipAndAttack()
            end
        end)
    else
        if connectionLoop then connectionLoop:Disconnect() end
    end
end)

godModeBtn.MouseButton1Click:Connect(function()
    godmodeEnabled = not godmodeEnabled
    setButtonActive(godModeBtn, godGrad, godStroke, godmodeEnabled, "🛡️ God Mode: ON", "🛡️ God Mode: OFF")

    if godmodeEnabled then
        godConnection = RunService.Heartbeat:Connect(function()
            local char = localPlayer.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                local hum = char:FindFirstChildOfClass("Humanoid")
                hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                hum.Health = hum.MaxHealth
            end
        end)
    else
        if godConnection then godConnection:Disconnect() end
    end
end)

bringBtn.MouseButton1Click:Connect(function()
    bringBossEnabled = not bringBossEnabled
    setButtonActive(bringBtn, bringGrad, bringStroke, bringBossEnabled, "🧲 Bring " .. DISPLAY_TARGET_NAME .. ": ON", "🧲 Bring " .. DISPLAY_TARGET_NAME .. ": OFF")

    if bringBossEnabled then
        bringLoop = RunService.Heartbeat:Connect(function()
            local bossModel, bossRoot = findBossRoot()
            local char = localPlayer.Character
            if bossRoot and char and char:FindFirstChild("HumanoidRootPart") then
                -- Increased distance to 8 studs in front and 1 stud higher
                bossRoot.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, 1, -8)
            end
        end)
