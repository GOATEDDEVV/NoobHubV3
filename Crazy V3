pickupBtn.MouseButton1Click:Connect(function()
    autoPickupItemsEnabled = not autoPickupItemsEnabled
    setButtonActive(pickupBtn, pickupGrad, pickupStroke, autoPickupItemsEnabled, "🎁 Auto Pickup Items: ON", "🎁 Auto Pickup Items: OFF")

    if autoPickupItemsEnabled then
        pickupLoop = RunService.Heartbeat:Connect(function()
            local char = localPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end

            for _, item in ipairs(Workspace:GetChildren()) do
                if item:IsA("Tool") or item:IsA("Model") then
                    for _, target in ipairs(TARGET_ITEMS) do
                        if string.find(string.lower(item.Name), string.lower(target)) then
                            local handle = item:FindFirstChild("Handle") or item.PrimaryPart or item:FindFirstChildOfClass("BasePart")
                            if handle then
                                handle.CFrame = char.HumanoidRootPart.CFrame
                            end
                        end
                    end
                end
            end
        end)
    else
        if pickupLoop then pickupLoop:Disconnect() end
    end
end)

