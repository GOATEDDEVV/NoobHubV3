-- Helper for active state styling
local function setButtonActive(btn, grad, stroke, active, textOn, textOff)
    btn.Text = active and textOn or textOff
    if active then
        grad.Color = ColorSequence.new(Color3.fromRGB(210, 245, 225), Color3.fromRGB(175, 230, 200))
        stroke.Color = Color3.fromRGB(40, 180, 100)
        btn.TextColor3 = Color3.fromRGB(15, 80, 40)
    else
        grad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(235, 238, 245))
        stroke.Color = Color3.fromRGB(210, 215, 225)
        btn.TextColor3 = Color3.fromRGB(50, 55, 70)
    end
end

